    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.545.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "swr": "^2.3.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
