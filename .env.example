# =============================================================================
# ORCA Financial — environment template
# Sao chép thành `.env` (local) hoặc khai báo trên Cloudflare Dashboard / wrangler.
# Secrets: KHÔNG commit giá trị thật. Trên CF dùng Secret (encrypted).
# =============================================================================

# --- Runtime ---
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
CLOUDFLARE_WORKERS=1
VNDIRECT_WS_DISABLED=true

# --- Auth / DB (Secret) ---
JWT_SECRET=
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Redis / Upstash (Secret, optional — fallback in-memory nếu thiếu) ---
# TCP URL bắt đầu bằng redis:// hoặc rediss://
UPSTASH_REDIS_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# --- LLM: OpenRouter (primary) + Groq (last-resort) ---
# Secrets
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Models (plain vars) — khớp production Dashboard
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
GROQ_MODEL=llama-3.3-70b-versatile
AI_MODEL_ANALYSIS=qwen/qwen3.8-27b:free
AI_MODEL_ANALYSIS_FALLBACKS=inclusionai/ling-3.0-flash-fin:free
AI_MODEL_REPORT=qwen/qwen3.8-27b:free
AI_MODEL_REPORT_FALLBACKS=inclusionai/ling-3.0-flash-fin:free
AI_MODEL_REASONING=inclusionai/ling-3.0-flash-fin:free
AI_MODEL_REASONING_FALLBACKS=qwen/qwen3.8-27b:free
AI_MODEL_CLASSIFICATION_FALLBACKS=
AI_MODEL=
# Cascade
AI_LLM_CASCADE_MODE=race
AI_LLM_MAX_CASCADE=3
AI_LLM_FALLBACK_BACKEND=groq
# Optional local / OpenAI-compatible endpoint (overrides base URL when set)
AI_BASE_URL=
GROQ_BASE_URL=

# --- Reports (giờ VN) ---
REPORT_AUTO_DAILY=true
REPORT_MORNING_TIME=08:20
REPORT_SUMMARY_TIME=15:50
CRON_SECRET=

# --- SSI FastConnect (Secret) ---
# Canonical: SSI_FC_CONSUMER_ID / SSI_FC_CONSUMER_SECRET
# Aliases được hỗ trợ: SSI_API_KEY/SSI_API_SECRET, SSI_CONSUMER_ID/SSI_CONSUMER_SECRET
SSI_FC_CONSUMER_ID=
SSI_FC_CONSUMER_SECRET=
SSI_API_KEY=
SSI_API_SECRET=
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_PRIVATE_KEY=
SSI_FC_DATA_BASE_URL=
SSI_FC_HUB_URL=
SSI_WS_DISABLED=

# --- Market data providers (optional) ---
VNSTOCK_API_KEY=
VNSTOCK_BASE_URL=
VNDIRECT_BASE_URL=
VNDIRECT_FALLBACK_BASE_URLS=
VNDIRECT_WS_URL=
BINANCE_API_KEY=
BINANCE_BASE_URL=
BINANCE_FAPI_BASE_URL=
BINANCE_WS_DISABLED=
BIQUOTE_API_KEY=
BIQUOTE_BASE_URL=
COINGECKO_BASE_URL=
COINGECKO_PRO_API_KEY=
MSN_FINANCE_API_KEY=
POLYGON_API_KEY=
POLYGON_API_BASE_URL=
SIMPLIZE_API_KEY=
SIMPLIZE_BASE_URL=
VIETNAMBIZ_BASE_URL=

# --- Vietnam Derivatives (P0) ---
DERIVATIVES_QUOTE_URL=
DERIVATIVES_QUOTE_API_KEY=
