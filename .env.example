# ==========================================================================
# Orca Multi-Finance — Environment Variables
# Điền giá trị thật rồi import lên Vercel (Project Settings → Environment
# Variables → Import .env). KHÔNG commit file này chứa secret thật vào Git
# (đã có trong .gitignore).
# ==========================================================================

# --- Runtime ---
NODE_ENV=production

# ==========================================================================
# BẮT BUỘC — Neon PostgreSQL
# App dùng driver "pg" (node-postgres) qua drizzle-orm/node-postgres, KHÔNG
# phải @neondatabase/serverless — nên phải dùng connection string chuẩn TCP
# của Neon (không phải HTTP driver), và bắt buộc có sslmode=require vì Neon
# luôn yêu cầu TLS.
#
# Vào Neon Console → Project → Connect → chọn "Connection string":
#
# 1) DATABASE_URL: dùng bản POOLED (host có hậu tố "-pooler"), vì Vercel
#    chạy serverless — mỗi request có thể mở connection mới, không có
#    pooler sẽ dễ hết connection limit của Neon.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require

# 2) DATABASE_URL_UNPOOLED: dùng bản KHÔNG pooled (host KHÔNG có "-pooler")
#    cho các thao tác cần session dài/prepared statement — đặc biệt là
#    chạy migration (drizzle-kit generate/push/migrate). PgBouncer ở chế độ
#    transaction pooling (bản -pooler) không hỗ trợ tốt việc này.
#    Lưu ý: drizzle.config.json hiện đang hardcode URL localhost, cần trỏ
#    lại sang biến này (hoặc process.env.DATABASE_URL_UNPOOLED) để migrate
#    đúng vào Neon thay vì localhost.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require

# ==========================================================================
# BẢO MẬT — có default không an toàn cho dev, PHẢI đặt giá trị riêng ở production
# ==========================================================================

# Dùng để ký JWT (auth/session). Tạo bằng: openssl rand -base64 48
JWT_SECRET=

# ==========================================================================
# HẠ TẦNG PLATFORM (khuyến nghị dùng ở production)
# ==========================================================================

# Redis cho cache/rate-limit/realtime (Upstash Redis URL dạng rediss://...)
REDIS_URL=

# ==========================================================================
# DATA PROVIDERS — Chứng khoán Việt Nam (vnstock)
# ==========================================================================
VNSTOCK_BASE_URL=https://api.vnstock.com
VNSTOCK_API_KEY=

# ==========================================================================
# DATA PROVIDERS — VNDirect (fallback nguồn dữ liệu VN)
# ==========================================================================
VNDIRECT_BASE_URL=https://finfo-api.vndirect.com.vn

# ==========================================================================
# DATA PROVIDERS — Crypto (Binance)
# ==========================================================================
BINANCE_BASE_URL=
BINANCE_FAPI_BASE_URL=
BINANCE_API_KEY=
# Bật/tắt kết nối WebSocket realtime Binance (true/false)
BINANCE_WS_ENABLED=true
BINANCE_WS_SPOT_URL=
BINANCE_WS_FUT_URL=

# ==========================================================================
# DATA PROVIDERS — Forex (Biquote)
# ==========================================================================
BIQUOTE_BASE_URL=
BIQUOTE_API_KEY=

# ==========================================================================
# DATA PROVIDERS — Hàng hóa (Vietnambiz + Simplize)
# ==========================================================================
VIETNAMBIZ_BASE_URL=https://vietnambiz.vn
SIMPLIZE_BASE_URL=https://api.simplize.vn
SIMPLIZE_API_KEY=
SIMPLIZE_COMMODITY_PATH=/api/commodity/price/current

# Optional: map mã hàng hóa thế giới sang instrument ID của MSN Finance
# Định dạng JSON, ví dụ: {"GOLD":"a3xnzv","OIL":"a3xnzu"}
MSN_COMMODITY_MAP=
MSN_FINANCE_API_KEY=

# ==========================================================================
# AI AGENT — LLM tương thích OpenAI (dùng cho /agent nhận định tự động)
# Đang dùng Groq (endpoint OpenAI-compatible). Lấy API key tại
# console.groq.com/keys. Danh sách model + tên chính xác: xem
# console.groq.com/docs/models (tên model có thể đổi theo thời gian).
# ==========================================================================
AI_PROVIDER_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# ==========================================================================
# LỊCH BÁO CÁO TỰ ĐỘNG (Morning Brief / Market Summary)
# ==========================================================================
# Bật/tắt tự động tạo báo cáo hàng ngày (true/false)
REPORT_AUTO_DAILY=true
# Giờ chạy Morning Brief (định dạng HH:mm, giờ VN)
REPORT_MORNING_TIME=08:15
# Giờ chạy Market Summary cuối phiên (định dạng HH:mm, giờ VN)
REPORT_SUMMARY_TIME=15:45