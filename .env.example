# ==========================================================================
# ORCA Financial — Environment Variables (.env.example)
# ==========================================================================
# Copy → .env (local) hoặc Vercel → Settings → Environment Variables
# Không commit file .env thật.

# --- Database ---
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require

JWT_SECRET=
NODE_ENV=production
# Redis (Upstash recommended) — shared SWR cache across serverless instances.
# Without REDIS_URL, cache is per-instance in-memory only (OK for single region,
# but screeners can thundering-herd on cold starts).
REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379
# UPSTASH_REDIS_URL=  # alias accepted by env.ts

# ==========================================================================
# Chứng khoán VN — SSI FastConnect Data
# ==========================================================================
SSI_FC_CONSUMER_ID=
SSI_FC_CONSUMER_SECRET=
SSI_API_KEY=
SSI_API_SECRET=
SSI_FC_DATA_BASE_URL=https://fc-data.ssi.com.vn
SSI_FC_HUB_URL=https://fc-datahub.ssi.com.vn/v2.0
# Realtime WS — default OFF on Vercel (serverless cannot keep long-lived sockets).
# Set to false only if you run a long-lived Node host or intentionally opt-in.
SSI_WS_DISABLED=true

VNDIRECT_BASE_URL=https://api-finfo.vndirect.com.vn
VNDIRECT_WS_URL=
# Leave empty on Vercel (= disabled). Local dev: unset or false to enable.
VNDIRECT_WS_DISABLED=true
VNSTOCK_BASE_URL=https://api.vnstock.com
VNSTOCK_API_KEY=

BINANCE_BASE_URL=
BINANCE_FAPI_BASE_URL=
BINANCE_API_KEY=
BINANCE_WS_DISABLED=true

BIQUOTE_BASE_URL=
BIQUOTE_API_KEY=
VIETNAMBIZ_BASE_URL=https://vietnambiz.vn
SIMPLIZE_BASE_URL=https://api.simplize.vn
SIMPLIZE_API_KEY=

# --- AI / LLM (OpenRouter-first + fast cascade free) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free

AI_MODEL_ANALYSIS=inclusionai/ling-3.0-flash-fin:free
AI_MODEL_ANALYSIS_FALLBACKS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
AI_MODEL_REPORT=inclusionai/ling-3.0-flash-fin:free
AI_MODEL_REPORT_FALLBACKS=qwen/qwen3.8-27b:free,openrouter/free

AI_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b:free
AI_MODEL_REASONING_FALLBACKS=thinkingmachines/inkling:free,openrouter/free

# Cascade speed (production defaults)
AI_LLM_CASCADE_MODE=race
AI_LLM_MAX_CASCADE=3

# Optional last-resort when OpenRouter 429 / 5xx
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_LLM_FALLBACK_BACKEND=groq

AI_MODEL=inclusionai/ling-3.0-flash-fin:free

REPORT_AUTO_DAILY=true
# External scheduler (cronjob.org) — see docs/CRONJOB_ORG.md
# APP_URL=https://your-app.vercel.app
CRON_SECRET=
NEXT_TELEMETRY_DISABLED=1
