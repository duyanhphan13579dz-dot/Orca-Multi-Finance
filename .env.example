# ==========================================================================
# ORCA Financial — .env.example
# ==========================================================================
# Copy to `.env` for local development:  cp .env.example .env
# On Netlify/Vercel set the same names in the host dashboard.
#
# Golden rules of this codebase:
#   • No variable here is ever exposed to the browser (src/lib/env.ts is
#     `server-only`; there is no NEXT_PUBLIC_* usage).
#   • Every provider is optional. A missing key puts that asset class into
#     UNAVAILABLE/DEGRADED with an honest on-screen note — the platform never
#     fabricates market data.
#   • Only DATABASE_URL + JWT_SECRET are needed for a sane baseline
#     (crypto via Binance, forex fallbacks, gold via VietnamBiz/PAXG, RSS news).
# ==========================================================================

# --------------------------------------------------------------------------
# PLATFORM — required
# --------------------------------------------------------------------------
# PostgreSQL connection string. Not needed at *build* time (the client is
# lazily initialised in src/db/index.ts), but required at runtime for auth,
# watchlist sync, reports archive and provider-health persistence.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# HS256 signing key for the session cookie. MUST be set in production —
# the built-in fallback is an intentionally insecure dev value.
JWT_SECRET="change-me-to-a-long-random-string"

# development | production | test
NODE_ENV="development"

# --------------------------------------------------------------------------
# PLATFORM — optional
# --------------------------------------------------------------------------
# Redis mirror for the TTL cache. Must be a TCP endpoint (redis:// or rediss://).
# `UPSTASH_REDIS_URL` is accepted as an alias. An Upstash *REST* URL
# (https://…) cannot be used by ioredis: it is ignored and reported through
# `redisNote` on /api/v1/system/info instead of failing silently.
REDIS_URL=""
# UPSTASH_REDIS_URL="rediss://default:<password>@<region>.upstash.io:6379"

# --------------------------------------------------------------------------
# VIETNAM STOCKS — primary product surface
# --------------------------------------------------------------------------
# VNStock is the primary VN equities source. Without VNSTOCK_API_KEY the whole
# VN module (indices, board, screener, heatmap VN, financials) reports
# UNAVAILABLE — by design, never mocked.
VNSTOCK_BASE_URL="https://api.vnstock.com"
VNSTOCK_API_KEY=""

# VNDirect is the secondary/validation source used by the reconciliation engine
# (public community endpoints; no key required).
VNDIRECT_BASE_URL="https://finfo-api.vndirect.com.vn"

# --------------------------------------------------------------------------
# CRYPTO — Binance (no key required for public market data)
# --------------------------------------------------------------------------
BINANCE_BASE_URL=""
BINANCE_FAPI_BASE_URL=""
# Only needed for private/account endpoints (currently unused).
BINANCE_API_KEY=""

# Centralized WebSocket engine (src/lib/realtime/binance-ws.ts).
# Set BINANCE_WS_DISABLED=true on serverless hosts (Netlify/Vercel Functions):
# short-lived instances cannot hold a persistent socket, and the platform falls
# back to REST polling with correct freshness labels. Leave unset/false on a
# long-running Node host (VPS/container) to get LIVE ticks + SSE candles.
BINANCE_WS_DISABLED=""
BINANCE_WS_SPOT_URL="wss://stream.binance.com:9443/stream?streams=!ticker@arr"
BINANCE_WS_FUT_URL="wss://fstream.binance.com/stream?streams=!markPrice@arr"
BINANCE_WS_KLINE_URL="wss://stream.binance.com:9443/ws"
# Max concurrent per-symbol kline subscriptions on the shared socket.
BINANCE_WS_MAX_KLINES="48"

# --------------------------------------------------------------------------
# FOREX
# --------------------------------------------------------------------------
# Biquote is the primary realtime FX source; without it the service falls back
# to exchangerate-api (latest) + Frankfurter/ECB (daily reference history).
BIQUOTE_BASE_URL=""
BIQUOTE_API_KEY=""

# --------------------------------------------------------------------------
# COMMODITIES
# --------------------------------------------------------------------------
# VietnamBiz Data portal (https://data.vietnambiz.vn/goods) is the source the
# commodity service currently reads; no key required.
VIETNAMBIZ_BASE_URL="https://vietnambiz.vn"

# Reserved / not wired into the active commodity pipeline yet (surfaced as
# "configured" flags on /api/v1/system/info only).
SIMPLIZE_BASE_URL="https://api.simplize.vn"
SIMPLIZE_API_KEY=""
MSN_FINANCE_API_KEY=""
# JSON map of MSN instrument ids, e.g. {"GOLD":"id","WTI":"id"}
MSN_COMMODITY_MAP=""

# --------------------------------------------------------------------------
# REPORTS + SCHEDULER (Asia/Ho_Chi_Minh)
# --------------------------------------------------------------------------
REPORT_AUTO_DAILY="true"
REPORT_MORNING_TIME="08:15"
REPORT_SUMMARY_TIME="15:45"
COMMODITIES_AUTO_DAILY="true"
COMMODITIES_REFRESH_TIME="07:30"

# Protects /api/v1/cron/commodities. Vercel/Netlify cron sends
# `Authorization: Bearer <CRON_SECRET>`; `?secret=` is also accepted.
# When unset, the endpoint is open in development and rejected in production.
CRON_SECRET=""

# --------------------------------------------------------------------------
# AI / LLM GATEWAY (optional — OpenAI-compatible)
# --------------------------------------------------------------------------
# Without AI_PROVIDER_KEY every intelligence endpoint answers from the
# deterministic quant engines (`mode: "deterministic"`); the LLM only ever
# receives a validated data contract and its output is re-validated.
AI_PROVIDER_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# Per-role overrides (src/lib/ai/gateway.ts): reasoning | analysis | classification
AI_MODEL_REASONING=""
AI_MODEL_ANALYSIS=""
AI_MODEL_CLASSIFICATION=""
