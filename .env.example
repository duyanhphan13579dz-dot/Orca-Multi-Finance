# ==========================================================================
# ORCA Financial — Environment Variables (.env.example)
# ==========================================================================
# Copy → .env (local) hoặc Vercel → Settings → Environment Variables
# Không commit file .env thật.
#
# SINGLE SOURCE OF TRUTH: mọi biến dưới đây được đọc DUY NHẤT trong
# `src/lib/env.ts` (module `server-only`). Các module khác dùng `env.<tên>`,
# không đọc `process.env` trực tiếp — thêm biến mới thì khai báo ở đó trước.
# (Ngoại lệ duy nhất: shim `ensureSsiEnvAliases()` trong
#  src/lib/providers/ssi-credentials.ts mirror alias SSI_FC_* cho code ngoài repo.)

# --- Database ---
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require
# Chỉ drizzle-kit (migrations) dùng — connection trực tiếp, không qua PgBouncer.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require

JWT_SECRET=
NODE_ENV=production
# Redis mirror cho cache (optional). Host như Netlify inject UPSTASH_REDIS_URL —
# cả hai tên đều được chấp nhận. Bắt buộc dạng redis:// hoặc rediss:// (TCP):
# Upstash REST URL (https://…) không dùng được với ioredis → mirror tự TẮT.
REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379
UPSTASH_REDIS_URL=

# ==========================================================================
# Chứng khoán VN — SSI FastConnect Data (PRIMARY khi đã set key)
# Docs: https://developers.ssi.com.vn/
# Guide: https://guide.ssi.com.vn/ssi-products/fastconnect-data
# Key tạo trên SSI iBoard → Dịch vụ API (chỉ hiện 1 lần)
#   ConsumerID  → SSI_FC_CONSUMER_ID  (hoặc SSI_API_KEY)
#   ConsumerSecret → SSI_FC_CONSUMER_SECRET  (hoặc SSI_API_SECRET)
# ==========================================================================
SSI_FC_CONSUMER_ID=
SSI_FC_CONSUMER_SECRET=
# Aliases (Vercel) — cùng giá trị ConsumerID / ConsumerSecret
SSI_API_KEY=
SSI_API_SECRET=
# Alias thứ ba được chấp nhận (first non-empty wins theo thứ tự trên)
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=

SSI_FC_DATA_BASE_URL=https://fc-data.ssi.com.vn
SSI_FC_HUB_URL=https://fc-datahub.ssi.com.vn/v2.0
# Vercel / serverless → SSI_WS_DISABLED=true  (REST vẫn chạy; sổ lệnh cần WS)
# VPS / Node 24/7     → SSI_WS_DISABLED=false
SSI_WS_DISABLED=true
# `signalr` = transport SignalR cho tenant DataHub legacy; bỏ trống = WS thuần
SSI_WS_PROTOCOL=
# Preload VN30 + mã thanh khoản khi stream All được cấp (mặc định true)
SSI_WS_PRELOAD=true

# --- Fallback VN ---
VNDIRECT_BASE_URL=https://api-finfo.vndirect.com.vn
VNSTOCK_BASE_URL=https://api.vnstock.com
VNSTOCK_API_KEY=

# --- Crypto ---
BINANCE_BASE_URL=
BINANCE_FAPI_BASE_URL=
BINANCE_API_KEY=
# Serverless không giữ được WebSocket → đặt true, engine hạ về REST polling 12s
BINANCE_WS_DISABLED=
BINANCE_WS_SPOT_URL=wss://stream.binance.com:9443/stream?streams=!ticker@arr
BINANCE_WS_FUT_URL=wss://fstream.binance.com/stream?streams=!markPrice@arr
BINANCE_WS_KLINE_URL=wss://stream.binance.com:9443/ws
BINANCE_WS_MAX_KLINES=48

# --- Forex / Hàng hóa ---
BIQUOTE_BASE_URL=
BIQUOTE_API_KEY=
VIETNAMBIZ_BASE_URL=https://vietnambiz.vn
SIMPLIZE_BASE_URL=https://api.simplize.vn
SIMPLIZE_API_KEY=
# JSON map {"GOLD":"<msnInstrumentId>",...} cho giá hàng hóa thế giới qua MSN
MSN_COMMODITY_MAP=
# Bỏ trống → dùng public web key mà frontend MSN đang dùng
MSN_FINANCE_API_KEY=

# ==========================================================================
# SSC / công bố thông tin chính thức (congbothongtin.ssc.gov.vn)
# ==========================================================================
SSC_PORTAL_URL=https://congbothongtin.ssc.gov.vn
SSC_NEWS_SEARCH_URL=
# 1|true → bật Playwright scrape (ticker/PDF coverage đầy đủ)
# cần: npm run ssc:install-browser
SSC_HEADLESS=
SSC_HTTP_UA=
# Adapter JSON optional (channel nào có URL thì được probe)
SSC_IDS_BASE_URL=
HOSE_DISCLOSURE_URL=
HNX_DISCLOSURE_URL=
COMPANY_IR_BASE_URL=

# ==========================================================================
# AI (LLM Gateway — ưu tiên OpenRouter)
#
# CHỈ CẦN 2 BIẾN: OPENROUTER_API_KEY + OPENROUTER_MODEL.
# DEFAULT_LLM_MODEL = "openai/gpt-oss-120b" (khai báo duy nhất trong
# src/lib/env.ts) — model duy nhất có mặt trên cả OpenRouter lẫn Groq, nên
# dùng được cho cả 2 backend mà AI Agent gọi song song. Để trống mọi biến model
# thì hệ thống rơi về default đó.
# ==========================================================================
OPENROUTER_API_KEY=
# Nút vặn chính: ảnh hưởng cả gateway (mọi role) lẫn AI Agent backend OpenRouter
OPENROUTER_MODEL=
# Tương thích ngược (aiProviderKey = OPENROUTER_API_KEY → AI_PROVIDER_KEY → GROQ_API_KEY)
AI_PROVIDER_KEY=
# Rỗng → tự suy ra https://openrouter.ai/api/v1 khi có OPENROUTER_API_KEY.
# BẮT BUỘC set khi chỉ dùng Groq: https://api.groq.com/openai/v1
AI_BASE_URL=
# Chuỗi resolve: OPENROUTER_MODEL → AI_MODEL → AI_MODEL_REPORT → DEFAULT_LLM_MODEL
AI_MODEL=
# Phân vai model (rỗng → rơi về OPENROUTER_MODEL → AI_MODEL → default)
AI_MODEL_REASONING=
AI_MODEL_REPORT=
AI_MODEL_ANALYSIS=
# Fast path: AI Agent gọi Groq cho intent ngoài vn-market/vn-stock/wealth/compare.
# Model hợp lệ phía Groq: openai/gpt-oss-120b · openai/gpt-oss-20b ·
# qwen/qwen3.8-27b · qwen/qwen3.6-27b · minimaxai/minimax-m2.7
# (lưu ý: qwen/qwen3-32b KHÔNG có trên Groq)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# --- Cron / Scheduler ---
CRON_SECRET=
REPORT_AUTO_DAILY=true
REPORT_MORNING_TIME=08:15
REPORT_SUMMARY_TIME=15:45
COMMODITIES_AUTO_DAILY=true
COMMODITIES_REFRESH_TIME=07:30

NEXT_TELEMETRY_DISABLED=1
