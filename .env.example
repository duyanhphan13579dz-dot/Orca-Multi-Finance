# ==========================================================================
# ORCA Financial — Environment Variables (.env.example)
# ==========================================================================
# Local:      cp .env.example .env
# Netlify:    Site configuration → Environment variables (hoặc Import .env)
# Vercel:     Project Settings → Environment Variables → Import .env
#
# KHÔNG bao giờ commit file .env thật (đã nằm trong .gitignore).
#
# Quy tắc của codebase này:
#   • Không biến nào ở đây được đẩy xuống browser — src/lib/env.ts là module
#     `server-only`, toàn bộ codebase không dùng NEXT_PUBLIC_*.
#   • MỌI provider đều optional. Thiếu key → asset class đó chuyển sang
#     UNAVAILABLE/DEGRADED kèm ghi chú công khai trên UI; nền tảng không bao
#     giờ bịa số liệu thị trường.
#   • Baseline tối thiểu để chạy: DATABASE_URL + JWT_SECRET. Khi đó crypto
#     (Binance public), forex (fallback thật), vàng (VietnamBiz/PAXG) và tin
#     RSS đã hoạt động.
#
# Danh sách dưới đây được đối chiếu trực tiếp với code: mọi biến đều có nơi
# đọc thật (src/lib/env.ts, binance-ws.ts, scheduler.ts, cron route…). Các
# biến KHÔNG được code đọc sẽ được đánh dấu rõ ở cuối file.
# ==========================================================================


# ==========================================================================
# 1. BẮT BUỘC — Database (Neon PostgreSQL)
# ==========================================================================
# App dùng driver "pg" (node-postgres) qua drizzle-orm/node-postgres, KHÔNG
# phải @neondatabase/serverless — nên phải dùng connection string chuẩn TCP
# của Neon (không phải HTTP driver), và bắt buộc sslmode=require vì Neon luôn
# yêu cầu TLS.
#
# Neon Console → Project → Connect → "Connection string":
#   • Bản POOLED (host có hậu tố "-pooler") dùng cho runtime, vì host
#     serverless (Netlify/Vercel Functions) mở connection mới theo request —
#     không có pooler sẽ chạm connection limit của Neon.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require

#   • Bản KHÔNG pooled (host KHÔNG có "-pooler") dùng cho migration
#     (drizzle-kit generate/push/migrate): PgBouncer ở chế độ transaction
#     pooling không hỗ trợ tốt session dài / prepared statement.
#     drizzle.config.ts đọc biến này trước, fallback về DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require

# Ghi chú build: DATABASE_URL KHÔNG còn bắt buộc ở *build time* — client DB
# khởi tạo lười (src/db/index.ts), nên bước "Collecting page data" của
# `next build` không fail khi host không inject DB URL vào môi trường build.
# Runtime vẫn cần nó cho auth, watchlist sync, reports archive, provider health.


# ==========================================================================
# 2. BẢO MẬT — có default KHÔNG an toàn cho dev, bắt buộc đặt ở production
# ==========================================================================
# Ký JWT (HS256) cho session cookie. Tạo bằng: openssl rand -base64 48
JWT_SECRET=

# development | production | test
NODE_ENV=production


# ==========================================================================
# 3. HẠ TẦNG PLATFORM — Redis (optional, mirror cho TTL cache)
# ==========================================================================
# Phải là endpoint TCP dạng redis:// hoặc rediss:// (ioredis không nói chuyện
# qua HTTP). UPSTASH_REDIS_URL được chấp nhận như alias của REDIS_URL.
# Giá trị không đúng dạng TCP sẽ bị bỏ qua và báo lý do qua `redisNote` trên
# /api/v1/system/info — không tắt âm thầm.
REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379
# UPSTASH_REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379


# ==========================================================================
# 4. DATA PROVIDERS — Chứng khoán Việt Nam (bề mặt sản phẩm chính)
# ==========================================================================
# VNStock là nguồn sơ cấp cho cổ phiếu VN. Không có VNSTOCK_API_KEY thì toàn
# bộ mảng VN (chỉ số, board, screener, heatmap VN, financials) báo UNAVAILABLE
# — đúng thiết kế, không mock.
VNSTOCK_BASE_URL=https://api.vnstock.com
VNSTOCK_API_KEY=

# VNDirect là nguồn thứ cấp/validation cho Reconciliation Engine
# (endpoint cộng đồng public, không cần key).
VNDIRECT_BASE_URL=https://finfo-api.vndirect.com.vn


# ==========================================================================
# 5. DATA PROVIDERS — Crypto (Binance, không cần key cho market data public)
# ==========================================================================
BINANCE_BASE_URL=
BINANCE_FAPI_BASE_URL=
# Chỉ cần cho endpoint private/account (hiện chưa dùng).
BINANCE_API_KEY=

# --- Centralized WebSocket engine (src/lib/realtime/binance-ws.ts) ---
# Biến điều khiển là BINANCE_WS_DISABLED (ngữ nghĩa ĐẢO: "true" = tắt).
#   • Host serverless (Netlify/Vercel Functions): đặt "true". Instance sống rất
#     ngắn, không giữ được socket bền; engine tự fallback REST polling (cache
#     12s) và nhãn freshness đổi từ LIVE sang FRESH/DELAYED một cách trung thực,
#     meta.source mất tiền tố "binance-ws".
#   • Host Node dài hạn (VPS/container): để trống hoặc "false" để có tick LIVE
#     + nến SSE thật.
BINANCE_WS_DISABLED=
BINANCE_WS_SPOT_URL=wss://stream.binance.com:9443/stream?streams=!ticker@arr
BINANCE_WS_FUT_URL=wss://fstream.binance.com/stream?streams=!markPrice@arr
BINANCE_WS_KLINE_URL=wss://stream.binance.com:9443/ws
# Số luồng kline theo symbol tối đa trên cùng một socket.
BINANCE_WS_MAX_KLINES=48


# ==========================================================================
# 6. DATA PROVIDERS — Forex
# ==========================================================================
# Biquote là nguồn FX realtime sơ cấp; không có nó thì service fallback sang
# exchangerate-api (latest) + Frankfurter/ECB (chuỗi tham chiếu ngày).
BIQUOTE_BASE_URL=
BIQUOTE_API_KEY=


# ==========================================================================
# 7. DATA PROVIDERS — Hàng hóa
# ==========================================================================
# Pipeline hàng hóa hiện đọc VietnamBiz Data portal
# (https://data.vietnambiz.vn/goods) — không cần key.
VIETNAMBIZ_BASE_URL=https://vietnambiz.vn

# Đã khai báo trong src/lib/env.ts nhưng CHƯA được nối vào pipeline hàng hóa
# đang chạy; chỉ xuất hiện dưới dạng cờ "configured" trên /api/v1/system/info.
SIMPLIZE_BASE_URL=https://api.simplize.vn
SIMPLIZE_API_KEY=
MSN_FINANCE_API_KEY=
# JSON map instrument ID của MSN Finance, ví dụ: {"GOLD":"a3xnzv","OIL":"a3xnzu"}
MSN_COMMODITY_MAP=


# ==========================================================================
# 8. AI AGENT — LLM tương thích OpenAI (optional)
# ==========================================================================
# Không có AI_PROVIDER_KEY thì agent chạy mode deterministic.
# Model mặc định: qwen/qwen3.8-27b
# AI_BASE_URL không bắt buộc: model dạng provider/model tự resolve endpoint
# (OpenRouter). Chỉ set AI_BASE_URL khi dùng provider khác.
AI_PROVIDER_KEY=
# AI_BASE_URL=
AI_MODEL=qwen/qwen3.8-27b

# Override theo từng vai trò (src/lib/ai/gateway.ts) — để trống thì dùng AI_MODEL.
AI_MODEL_REASONING=
AI_MODEL_ANALYSIS=
AI_MODEL_CLASSIFICATION=


# ==========================================================================
# 9. LỊCH BÁO CÁO TỰ ĐỘNG + CRON (giờ Asia/Ho_Chi_Minh)
# ==========================================================================
REPORT_AUTO_DAILY=true
REPORT_MORNING_TIME=08:15
REPORT_SUMMARY_TIME=15:45
COMMODITIES_AUTO_DAILY=true
COMMODITIES_REFRESH_TIME=07:30

# Bảo vệ /api/v1/cron/commodities. Cron của Vercel/Netlify gửi
# `Authorization: Bearer <CRON_SECRET>`; dạng `?secret=` cũng được chấp nhận.
# Nếu để trống: endpoint mở ở development và bị từ chối ở production.
CRON_SECRET=


# ==========================================================================
# 10. Build / CI (đặt trên host, không cần trong .env local)
# ==========================================================================
# Netlify cài dependencies với NODE_ENV=production → npm bỏ qua devDependencies.
# Nhóm gói bắt buộc cho `next build` (tailwindcss, @tailwindcss/postcss,
# postcss, typescript, @types/*) vì vậy nằm trong "dependencies" của
# package.json — ĐỪNG chuyển chúng sang devDependencies, build sẽ chết với
# "Cannot find module '@tailwindcss/postcss'".
# netlify.toml đặt thêm NPM_FLAGS=--include=dev làm lớp dự phòng.
NPM_FLAGS=
NEXT_TELEMETRY_DISABLED=1


# ==========================================================================
# BIẾN KHÔNG ĐƯỢC CODE ĐỌC (liệt kê để tránh nhầm lẫn — có thể xoá)
# ==========================================================================
# BINANCE_WS_ENABLED        → code dùng BINANCE_WS_DISABLED (ngữ nghĩa đảo)
# SIMPLIZE_COMMODITY_PATH   → không nơi nào đọc
# UPSTASH_REDIS_REST_TOKEN  → ioredis dùng TCP, không dùng REST token
# Nếu bạn thêm provider mới: khai báo trong src/lib/env.ts rồi mới thêm vào đây.
