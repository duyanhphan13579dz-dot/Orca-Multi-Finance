# ==========================================================================
# ORCA Financial — Environment Variables (.env.example)
# ==========================================================================
# Copy → .env (local) hoặc Vercel → Settings → Environment Variables
# Không commit file .env thật.

# --- Database ---
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require

JWT_SECRET=
NODE_ENV=production
REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379

# ==========================================================================
# Chứng khoán VN — SSI FastConnect v3 (PRIMARY khi đã set key)
# Docs: https://developers.ssi.com.vn/docs/api-reference
# ==========================================================================
#
# BẮT BUỘC cho market data v3 (quote/OHLCV intraday/chỉ số/master/universe):
#   SSI_API_KEY + SSI_API_SECRET → POST /api/v3/auth/token (không cần OTP)
#
# Trading (đặt/sửa/hủy lệnh + FCO) cần thêm:
#   - SSI_PRIVATE_KEY (khóa RSA định dạng XML RSAKeyValue, base64) để ký X-Signature
#   - OTP/SmartOTP khi lấy token giao dịch (gọi POST /api/v1/ssi/otp)
#   - Công tắc an toàn SSI_TRADING_ENABLED=true
#
# Sau khi set SSI_API_KEY/SECRET + Redeploy:
#   - REST  https://api.ssi.com.vn/api/v3/data/*  → PRIMARY
#   - WS    wss://stream.ssi.com.vn/ws/v3         → tick LIVE (nếu SSI_WS_DISABLED != true)
#   - Legacy FC Data v2 + VNDirect = fallback
SSI_API_KEY=
SSI_API_SECRET=

# REST base (mặc định production — thường không cần đổi)
SSI_API_BASE_URL=https://api.ssi.com.vn

# WebSocket streaming (engine tự nối ?access_token=... khi kết nối)
SSI_STREAMING_URL=wss://stream.ssi.com.vn/ws/v3

# --- Trading / FCO (chỉ khi giao dịch thật) ---
SSI_PRIVATE_KEY=
# Chỉ khi =true thì API đặt/sửa/hủy lệnh + FCO mới mở (mặc định TẮT)
SSI_TRADING_ENABLED=false
# Định danh thiết bị gửi lệnh (tùy chọn)
SSI_DEVICE_ID=

# ==========================================================================
# (Legacy) SSI FastConnect Data v2 — fallback khi chưa có key v3
# Guide: https://guide.ssi.com.vn/ssi-products/fastconnect-data
# Key tạo trên SSI iBoard → Dịch vụ API (chỉ hiện 1 lần)
# ==========================================================================
SSI_FC_CONSUMER_ID=
SSI_FC_CONSUMER_SECRET=

# REST base (mặc định production — thường không cần đổi)
SSI_FC_DATA_BASE_URL=https://fc-data.ssi.com.vn

# DataHub streaming (SignalR) — tick LIVE: X / B / MI / R / F
# Node/VPS dài hạn: để mặc định dưới đây, và SSI_WS_DISABLED=false hoặc để trống
SSI_FC_HUB_URL=https://fc-datahub.ssi.com.vn/v2.0

# WebSocket:
#   Vercel / serverless → SSI_WS_DISABLED=true  (REST vẫn primary SSI)
#   VPS / Node 24/7     → SSI_WS_DISABLED=false hoặc xóa dòng này
SSI_WS_DISABLED=true

# --- Fallback VN (luôn giữ) ---
VNDIRECT_BASE_URL=https://api-finfo.vndirect.com.vn
VNSTOCK_BASE_URL=https://api.vnstock.com
VNSTOCK_API_KEY=

# --- Crypto ---
BINANCE_BASE_URL=
BINANCE_FAPI_BASE_URL=
BINANCE_API_KEY=
BINANCE_WS_DISABLED=
BINANCE_WS_SPOT_URL=wss://stream.binance.com:9443/stream?streams=!ticker@arr
BINANCE_WS_FUT_URL=wss://fstream.binance.com/stream?streams=!markPrice@arr
BINANCE_WS_KLINE_URL=wss://stream.binance.com:9443/ws
BINANCE_WS_MAX_KLINES=48

# --- Forex / Hàng hóa ---
BIQUOTE_BASE_URL=
BIQUOTE_API_KEY=
VIETNAMBIZ_BASE_URL=https://vietnambiz.vn
SIMPLIZE_BASE_URL=https://api.simplize.vn
SIMPLIZE_API_KEY=
MSN_FINANCE_API_KEY=
MSN_COMMODITY_MAP=

# --- AI ---
AI_PROVIDER_KEY=
AI_MODEL=qwen/qwen3.8-27b
AI_MODEL_REASONING=
AI_MODEL_ANALYSIS=
AI_MODEL_CLASSIFICATION=

# --- Cron ---
REPORT_AUTO_DAILY=true
REPORT_MORNING_TIME=08:15
REPORT_SUMMARY_TIME=15:45
COMMODITIES_AUTO_DAILY=true
COMMODITIES_REFRESH_TIME=07:30
CRON_SECRET=

NPM_FLAGS=
NEXT_TELEMETRY_DISABLED=1
