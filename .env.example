# ============================================================================
# ORCA Financial — environment template
# Copy to `.env` and fill in the values you need:
#   cp .env.example .env
# Secrets are NEVER exposed to the browser (all read via src/lib/env.ts,
# a server-only module). API keys are optional per-module — see README.
# ============================================================================

# ------------------------------ Database (REQUIRED) --------------------------
# PostgreSQL connection string. The app throws at startup without it.
# Local default used by drizzle.config.json:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ------------------------------ Auth (REQUIRED in production) ---------------
# HS256 JWT signing secret. MUST be replaced in production — the code refuses
# nothing, but the built-in fallback is `orca-dev-insecure-secret-change-in-production`.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# ------------------------------ Vietnam stocks ------------------------------
# Primary provider for the core VN equities module. Without the key the VN
# modules stay honestly UNAVAILABLE (no mock data).
VNSTOCK_BASE_URL=https://api.vnstock.com
VNSTOCK_API_KEY=

# Secondary VN source (reconciliation/validation) — public endpoint, optional:
VNDIRECT_BASE_URL=https://finfo-api.vndirect.com.vn

# ------------------------------ Crypto (Binance) ----------------------------
# Public market data needs no key. Override hosts for geo/network setups.
BINANCE_BASE_URL=
BINANCE_FAPI_BASE_URL=
BINANCE_API_KEY=
# Centralized WebSocket engine (defaults to official Binance hosts):
BINANCE_WS_SPOT_URL=
BINANCE_WS_FUT_URL=
BINANCE_WS_ENABLED=true

# ------------------------------ Forex ----------------------------------------
# Primary realtime FX provider (optional; real fallbacks otherwise):
BIQUOTE_BASE_URL=
BIQUOTE_API_KEY=

# ------------------------------ Commodities ---------------------------------
VIETNAMBIZ_BASE_URL=https://vietnambiz.vn
SIMPLIZE_BASE_URL=https://api.simplize.vn
SIMPLIZE_API_KEY=
SIMPLIZE_COMMODITY_PATH=/api/commodity/price/current
# Optional MSN Finance instrument map, JSON: {"GOLD":"id","WTI":"id",...}
MSN_COMMODITY_MAP=
# Optional override; a public web key is compiled in as the default:
MSN_FINANCE_API_KEY=

# ------------------------------ Optional infra ------------------------------
# Enables the Redis mirror for the TTL cache when set.
REDIS_URL=

# ------------------------------ AI / LLM -------------------------------------
# OpenAI-compatible endpoint. Optional — deterministic engines are the default.
AI_PROVIDER_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Role-specific overrides (read dynamically by src/lib/ai/gateway.ts):
AI_MODEL_REASONING=
AI_MODEL_ANALYSIS=
AI_MODEL_CLASSIFICATION=

# ------------------------------ Report scheduler -----------------------------
# Auto-generates morning_brief / market_summary once per VN trading day.
REPORT_AUTO_DAILY=true
REPORT_MORNING_TIME=08:15
REPORT_SUMMARY_TIME=15:45
