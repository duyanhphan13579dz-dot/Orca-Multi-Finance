  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# ORCA — QLoRA tài chính đa mảng (Colab T4)\n",
        "\n",
        "Train **ngay từ đầu** đa thị trường: CK VN (market/stock/industry), hàng hóa, crypto, forex, lãi suất/vĩ mô, từ chối advice cứng.\n",
        "\n",
        "**Dataset sẵn ~133 mẫu** — chỉ việc chạy. Runtime → **T4 GPU**.\n",
        "\n",
        "File data: `datasets/llm-human-voice/samples/sft_multidomain_finance.jsonl`\n",
        "(Notebook tự tải + convert chat format.)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "!nvidia-smi\n",
        "import torch\n",
        "assert torch.cuda.is_available(), 'Bật T4 GPU'\n",
        "print(torch.cuda.get_device_name(0))"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "!pip install -q -U transformers==4.51.3 peft==0.15.2 trl==0.15.2 bitsandbytes==0.45.4 accelerate datasets sentencepiece protobuf"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Tải dataset đa mảng + convert chat"]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "import urllib.request, json\n",
        "from pathlib import Path\n",
        "from collections import Counter\n",
        "\n",
        "RAW_URL = 'https://raw.githubusercontent.com/duyanhphan13579dz-dot/Orca-Multi-Finance/main/datasets/llm-human-voice/samples/sft_multidomain_finance.jsonl'\n",
        "urllib.request.urlretrieve(RAW_URL, 'sft_multidomain_finance.jsonl')\n",
        "rows_raw = [json.loads(l) for l in open('sft_multidomain_finance.jsonl', encoding='utf-8') if l.strip()]\n",
        "print('samples', len(rows_raw), 'branches', dict(Counter(r['branch'] for r in rows_raw)))\n",
        "\n",
        "SYSTEM = '''Bạn là ORCA Agent — chuyên gia phân tích tài chính đa thị trường (CK Việt Nam, ngành, hàng hóa, crypto, forex, lãi suất, vĩ mô).\n",
        "Chỉ dùng số liệu trong CONTEXT/NARRATIVE và TÀI LIỆU TRUY XUẤT.\n",
        "Không bịa số, không khuyến nghị mua/bán tuyệt đối.\n",
        "Giọng senior research analyst.'''\n",
        "\n",
        "def format_retrieved(retrieved):\n",
        "    if not retrieved: return '(Không có đoạn tài liệu bổ sung.)'\n",
        "    return '\\n\\n'.join(f'[{i}] source={p.get(\\"source\\",\\"?\\")} {p.get(\\"title\\",\\"\\")}\\n{p.get(\\"content\\",\\"\\")}' for i,p in enumerate(retrieved,1))\n",
        "\n",
        "chat = []\n",
        "for rec in rows_raw:\n",
        "    user = (f\"CÂU HỎI: {rec['question']}\\n\\n\"\n",
        "            f\"NARRATIVE HỆ THỐNG:\\n{(rec.get('context_narrative') or '')[:10000]}\\n\\n\"\n",
        "            f\"CONTEXT JSON:\\n{json.dumps(rec.get('context_contract') or {}, ensure_ascii=False)[:12000]}\\n\\n\"\n",
        "            f\"TÀI LIỆU TRUY XUẤT:\\n{format_retrieved(rec.get('retrieved') or [])}\\n\\n\"\n",
        "            'Hãy viết phân tích tài chính chuyên sâu đa mảng, bám số liệu.')\n",
        "    chat.append({'messages': [\n",
        "        {'role': 'system', 'content': SYSTEM},\n",
        "        {'role': 'user', 'content': user},\n",
        "        {'role': 'assistant', 'content': rec.get('preferred_answer') or ''},\n",
        "    ]})\n",
        "Path('sft_multidomain_chat.jsonl').write_text('\\n'.join(json.dumps(c, ensure_ascii=False) for c in chat)+'\\n', encoding='utf-8')\n",
        "print('chat ready', len(chat))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Load Qwen2.5-7B 4-bit + LoRA r=32"]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "import torch\n",
        "from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n",
        "from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\n",
        "\n",
        "BASE_MODEL = 'Qwen/Qwen2.5-7B-Instruct'\n",
        "bnb = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_quant_type='nf4', bnb_4bit_compute_dtype=torch.bfloat16, bnb_4bit_use_double_quant=True)\n",
        "tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL, trust_remote_code=True)\n",
        "if tokenizer.pad_token is None: tokenizer.pad_token = tokenizer.eos_token\n",
        "model = AutoModelForCausalLM.from_pretrained(BASE_MODEL, quantization_config=bnb, device_map='auto', trust_remote_code=True)\n",
        "model.config.use_cache = False\n",
        "model = prepare_model_for_kbit_training(model)\n",
        "model = get_peft_model(model, LoraConfig(r=32, lora_alpha=64, lora_dropout=0.05, bias='none', task_type='CAUSAL_LM', target_modules=['q_proj','k_proj','v_proj','o_proj','gate_proj','up_proj','down_proj']))\n",
        "model.print_trainable_parameters()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Train 3 epoch"]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "from datasets import load_dataset\n",
        "from trl import SFTTrainer, SFTConfig\n",
        "\n",
        "raw = load_dataset('json', data_files='sft_multidomain_chat.jsonl', split='train')\n",
        "def formatting_func(example):\n",
        "    return tokenizer.apply_chat_template(example['messages'], tokenize=False, add_generation_prompt=False)\n",
        "\n",
        "args = SFTConfig(output_dir='./orca-multidomain-lora-out', num_train_epochs=3, per_device_train_batch_size=1, gradient_accumulation_steps=8, learning_rate=1.5e-4, lr_scheduler_type='cosine', warmup_ratio=0.05, logging_steps=5, save_strategy='epoch', bf16=True, optim='paged_adamw_8bit', max_seq_length=2048, packing=False, report_to='none')\n",
        "trainer = SFTTrainer(model=model, args=args, train_dataset=raw, processing_class=tokenizer, formatting_func=formatting_func)\n",
        "trainer.train()\n",
        "print('TRAIN DONE')"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "OUT='orca-analyst-lora'\n",
        "model.save_pretrained(OUT)\n",
        "tokenizer.save_pretrained(OUT)\n",
        "!zip -r orca-analyst-lora.zip orca-analyst-lora\n",
        "from google.colab import files\n",
        "files.download('orca-analyst-lora.zip')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Deploy\n",
        "```bash\n",
        "vllm serve Qwen/Qwen2.5-7B-Instruct --enable-lora --lora-modules orca-analyst-v1=./orca-analyst-lora --host 0.0.0.0 --port 8000\n",
        "```\n",
        "```bash\n",
        "AI_BASE_URL=https://YOUR_HOST/v1\n",
        "AI_MODEL_ANALYSIS=orca-analyst-v1\n",
        "AI_MODEL_ANALYSIS_FALLBACKS=qwen/qwen3.8-27b:free,inclusionai/ling-3.0-flash-fin:free\n",
        "```\n",
        "Nâng ~400 mẫu: annotate thêm cùng schema rồi train lại."
      ]
    }
  ]
